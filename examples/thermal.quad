// Types for heat in buildings: a room with one temperature, and a wall that
// conducts heat between two rooms. The examples two-rooms.quad and house.quad
// use this file.

%energy:      { dimension: "J", conserved: true }
%temperature: { scale: -6 }
%capacity:    { dimension: "J/K" }
%conductance: { dimension: "W/K" }

// What a thermal port shows of a room. The energy is the state of a room.
// The laws compute the temperature from it, so the temperature has the mark
// @derived: a value for it in an instance is the value at the start.
#Thermal: {
    temperature: %temperature @derived
    capacity:    %capacity
    energy:      %energy
}

#ThermalPort: #Port & #Thermal

// A room with one temperature. The law relates its energy and its
// temperature. The port `west` is a view of the room's own state.
#Room: #Phenomenon & #Thermal & {
    storage: .energy == .capacity * .temperature
    west: #ThermalPort & { temperature: .temperature, capacity: .capacity, energy: .energy }
}

// A wall with no thermal mass. A native kernel moves the heat.
#Wall: #Phenomenon & {
    hot:  #ThermalPort
    cold: #ThermalPort
    conductance: %conductance
    // the length of a step, as a part of the time constant of the two rooms.
    // An instance can give another value. The default is 1 percent.
    tolerance:   *1pct | %ratio
    evaluator:   "native.conduction"
    // what the kernel moves. The compile checks this statement against the kernel
    heat: #Interaction & { source: .hot.energy, sink: .cold.energy }
    // the power through the wall, for the reader: the kernel does not need it
    power: %energy / %time
    flow:  .power == .conductance * (.hot.temperature - .cold.temperature)
}
