// The kinds and the types of the two-room world (ADR 0011 section 2, ADR 0016).
%energy:      { dimension: "J", scale: -3, conserved: true }
%temperature: { scale: -6 }
%capacity:    { dimension: "J/K", scale: -3 }
%conductance: { dimension: "W/K", scale: -3 }

// The port and the room have the same three fields, with the same kinds, so
// one supertype declares them.
#Thermal: {
    temperature: %temperature
    capacity:    %capacity
    energy:      %energy
}

#ThermalPort: #Port & #Thermal

// A room with one temperature. A law is a field with a name. Its port is a
// view of its own state.
#LumpedRoom: #Phenomenon & #Thermal & {
    storage: .energy == .capacity * .temperature
    west: #ThermalPort & { temperature: .temperature, capacity: .capacity, energy: .energy }
}

// A wall with no thermal mass, between two thermal ports.
#Wall: #Phenomenon & {
    hot:  #ThermalPort
    cold: #ThermalPort
    conductance: %conductance
    tolerance:   %ratio
}

// The kernel moves the heat.
#ConductiveWall: #Wall & { evaluator: "native.conduction" }
